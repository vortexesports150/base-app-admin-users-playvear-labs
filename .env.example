# AI Studio-র "Secrets" প্যানেলে গিয়ে নিচের নামগুলো দিয়ে আপনার কীগুলো পেস্ট করুন:
# ==============================================================================


# ==============================================================================
# [A] CARTESIA PAID API KEY (রোটেট করবে না - ক্লোনিং ও মডেল V4 এর জন্য ফিক্সড)
# ==============================================================================
# নাম: CARTESIA_PAID_API_KEY  (অথবা CARTESIA_PAID_API)
# বিবরণ: আপনার পেইড বা সাবস্ক্রিপশন অ্যাকাউন্টের কী।
# ⚠️ এটি রোটেট করবে না। এটি শুধুমাত্র ভয়েস ক্লোনিং ও পেইড V4 মডেল সিন্থেসিসের জন্য সুরক্ষিত থাকবে।
CARTESIA_PAID_API_KEY=
# (বিকল্প নাম: CARTESIA_PAID_API)



# ==============================================================================
