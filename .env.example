# ==============================================================================
# একটি অ্যাকাউন্টের লিমিট শেষ হলে অটোমেটিকভাবে পরবর্তী কী-তে সুইচ করবে:

# 🟢 Cartesia api 1 (অ্যাকাউন্ট ১ এর কী - রোটেট করবে)
CARTESIA_API_1=
# (বিকল্প নাম: CARTESIA_API_KEY_1)

# 🟢 Cartesia api 2 (অ্যাকাউন্ট ২ এর কী - রোটেট করবে)
CARTESIA_API_2=
# (বিকল্প নাম: CARTESIA_API_KEY_2)

# 🟢 Cartesia api 3 (অ্যাকাউন্ট ৩ এর কী - রোটেট করবে)
